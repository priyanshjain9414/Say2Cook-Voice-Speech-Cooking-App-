
<div class="recipe-hero">
  <img
    src="<%= recipe.image %>"
    alt="<%= recipe.title %>"
    class="recipe-hero-img"
  />

  <div class="recipe-detail-info">
    <h1 class="recipe-detail-title"><%= recipe.title %></h1>

    
    <div class="recipe-badges">
      <span class="recipe-badge">
        <i class="fa-regular fa-clock"></i>
        Ready in <%= recipe.readyInMinutes %> min
      </span>
      <% if (recipe.servings) { %>
      <span class="recipe-badge">
        <i class="fa-solid fa-users"></i>
        Serves <%= recipe.servings %>
      </span>
      <% } %>
    </div>

    
    <% if (currentUser) { %>
    <form method="POST" action="/favourite/<%= recipe.id %>" class="fav-form">
      <input type="hidden" name="title" value="<%= recipe.title %>" />
      <input type="hidden" name="image" value="<%= recipe.image %>" />
      <button type="submit" class="fav-btn">
        <i class="fa-solid fa-heart"></i> Save to Favourites
      </button>
    </form>
    <% } %>

   
    <% if (recipe.nutrition && recipe.nutrition.nutrients && recipe.nutrition.nutrients.length) { %>
    <div>
      <h3 style="font-size:1rem; margin-bottom:10px">Nutrition Facts</h3>
      <table class="nutrition-table">
        <thead>
          <tr>
            <th>Nutrient</th>
            <th>Amount</th>
          </tr>
        </thead>
        <tbody>
          <% const important = ["Calories","Carbohydrates","Fat","Protein","Sugar","Fiber"]; %>
          <% recipe.nutrition.nutrients.forEach(function(n) { %>
          <% if (important.includes(n.name)) { %>
          <tr>
            <td><%= n.name %></td>
            <td class="<%= n.name === 'Calories' ? 'nutrition-highlight' : '' %>">
              <%= n.amount %> <%= n.unit %>
            </td>
          </tr>
          <% } %>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>
</div>

<hr />


<div class="section-block">
  <h3><i class="fa-solid fa-language" style="color:var(--brand);margin-right:6px"></i>Translate Recipe</h3>
  <div class="translate-bar">
    <select id="langSelect">
      <option value="en">🇬🇧 English</option>
      <option value="hi">🇮🇳 Hindi</option>
      <option value="mr">🇮🇳 Marathi</option>
      <option value="gu">🇮🇳 Gujarati</option>
      <option value="pa">🇮🇳 Punjabi</option>
      <option value="ta">🇮🇳 Tamil</option>
      <option value="te">🇮🇳 Telugu</option>
      <option value="kn">🇮🇳 Kannada</option>
      <option value="bn">🇮🇳 Bengali</option>
      <option value="ml">🇮🇳 Malayalam</option>
      <option value="ur">🇵🇰 Urdu</option>
      <option value="fr">🇫🇷 French</option>
      <option value="es">🇪🇸 Spanish</option>
      <option value="de">🇩🇪 German</option>
      <option value="zh-Hans">🇨🇳 Chinese</option>
      <option value="ja">🇯🇵 Japanese</option>
      <option value="ar">🇸🇦 Arabic</option>
      <option value="ru">🇷🇺 Russian</option>
      <option value="it">🇮🇹 Italian</option>
    </select>
    <button id="translateBtn" class="btn btn-outline btn-sm">
      <i class="fa-solid fa-rotate"></i> Translate
    </button>
  </div>
</div>

<hr />


<div class="section-block">
  <h3><i class="fa-solid fa-list-check" style="color:var(--brand);margin-right:6px"></i>Ingredients</h3>
  <ul class="ingredients">
    <% (recipe.extendedIngredients || []).forEach(function(ing) { %>
    <li><%= ing.original %></li>
    <% }) %>
  </ul>
</div>

<hr />


<div class="section-block">
  <h3><i class="fa-solid fa-shoe-prints" style="color:var(--brand);margin-right:6px"></i>Steps</h3>
  <% if ((recipe.analyzedInstructions || []).length) { %>
  <ol class="steps" id="stepsList">
    <% (recipe.analyzedInstructions || []).forEach(function(block) { %>
    <% (block.steps || []).forEach(function(s, i) { %>
    <li id="step-<%= i %>" class="step-text"><%= s.step %></li>
    <% }) %>
    <% }) %>
  </ol>
  <% } else { %>
  <p style="color:var(--text-3); font-size:0.9rem">No structured steps available.</p>
  <% if (recipe.instructions) { %>
  <p style="font-size:0.9rem; color:var(--text-2)"><%= recipe.instructions %></p>
  <% } %>
  <% } %>
</div>


<div class="controls-box">
  <p class="controls-label"><i class="fa-solid fa-microphone"></i> Voice Cooking Mode</p>

  <div class="controls">
    <button onclick="startCooking()" class="btn btn-primary btn-sm">
      <i class="fa-solid fa-play"></i> Start
    </button>
    <button onclick="stopCooking()" class="btn btn-ghost btn-sm">
      <i class="fa-solid fa-stop"></i> Stop
    </button>
    <button onclick="repeatStep()" class="btn btn-ghost btn-sm">
      <i class="fa-solid fa-rotate-left"></i> Repeat
    </button>
    <button onclick="nextStep()" class="btn btn-outline btn-sm">
      <i class="fa-solid fa-forward-step"></i> Next
    </button>
  </div>

  <div id="timer-controls" class="hidden" style="margin-top:10px; display:flex; gap:8px; flex-wrap:wrap">
    <button onclick="pauseTimer()" class="btn btn-ghost btn-sm">
      <i class="fa-solid fa-pause"></i> Pause Timer
    </button>
    <button onclick="resumeTimer()" class="btn btn-outline btn-sm">
      <i class="fa-solid fa-play"></i> Resume Timer
    </button>
  </div>

  <div class="voice-status">
    <p id="current-step" style="margin:0; font-size:0.875rem"></p>
  </div>

  <p id="timer" style="margin:8px 0 0"></p>
</div>

<script src="/speech.js"></script>
<script src="/translate.js"></script>
